{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/contracts/invitation-v1.schema.json",
  "title": "AgentPass invitation public read model v1",
  "description": "Tenant-bound public invitation projection. The contract version is fixed by this v1 schema identifier; version is the persisted optimistic-concurrency revision and is therefore a bounded positive integer rather than a schema discriminator. Raw invitation tokens and token hashes are never part of this schema.",
  "$comment": "organization_id is the authoritative tenant binding. An accepting human is authenticated by the session used for the accept operation; no bearer token, token hash, issuer actor, or untrusted actor field is represented in this public projection.",
  "x-agentpass-binding": {
    "contract_version": 1,
    "tenant_binding": { "path": "organization_id", "source": "read-model" },
    "subject_binding": { "path": "invitation_id", "source": "invitation target" },
    "actor_binding": { "source": "authenticated human session", "in_payload": false }
  },
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 9,
  "required": ["invitation_id", "organization_id", "role", "status", "version", "created_at", "expires_at"],
  "properties": {
    "invitation_id": { "$ref": "#/$defs/canonicalUuid" },
    "organization_id": { "$ref": "#/$defs/canonicalUuid" },
    "role": {
      "type": "string",
      "enum": ["admin", "auditor", "viewer"]
    },
    "status": {
      "type": "string",
      "enum": ["pending", "accepted", "revoked", "expired"]
    },
    "version": { "$ref": "#/$defs/resourceVersion" },
    "created_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "expires_at": { "$ref": "#/$defs/canonicalTimestamp" },
    "accepted_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "accepted_member_id": {
      "anyOf": [
        { "$ref": "#/$defs/canonicalUuid" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } } },
      "then": {
        "required": ["accepted_at"],
        "properties": { "accepted_at": { "$ref": "#/$defs/canonicalTimestamp" } }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["pending", "revoked", "expired"] } } },
      "then": {
        "properties": {
          "accepted_at": { "type": ["null"] },
          "accepted_member_id": { "type": ["null"] }
        }
      }
    }
  ],
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "canonicalTimestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 24,
      "maxLength": 24,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "resourceVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
