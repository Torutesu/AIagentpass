{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/contracts/recent-authorization-v1.schema.json",
  "title": "AgentPass consumed recent authorization result v1",
  "description": "Exact successful result returned by the recent-authorization service after atomic one-time consumption.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verified", "consumed", "challenge_id", "member_id", "organization_id", "operation", "authenticated_at"],
  "properties": {
    "verified": { "const": true },
    "consumed": { "const": true },
    "challenge_id": { "$ref": "#/$defs/uuid" },
    "member_id": { "$ref": "#/$defs/uuid" },
    "organization_id": { "$ref": "#/$defs/uuid" },
    "operation": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$" },
    "authenticated_at": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" }
  }
}
