{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/contracts/schemas/platform-session-assertion-v1.schema.json",
  "title": "AgentPass transient platform session WebAuthn assertion v1",
  "description": "The only browser-to-server assertion DTO. It contains exactly the eight required public fields plus optional user_handle; no raw challenge, member, organization, assignment, principal, or authority generation is accepted.",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 8,
  "maxProperties": 9,
  "required": ["version", "type", "challenge_id", "jti", "credential_id", "client_data_json", "authenticator_data", "signature"],
  "properties": {
    "version": { "const": 1 },
    "type": { "const": "agentpass.platform-session-assertion" },
    "challenge_id": { "$ref": "#/$defs/uuid" },
    "jti": { "$ref": "#/$defs/uuid" },
    "credential_id": { "$ref": "#/$defs/credentialId" },
    "client_data_json": { "$ref": "#/$defs/clientData" },
    "authenticator_data": { "$ref": "#/$defs/authenticatorData" },
    "signature": { "$ref": "#/$defs/signature" },
    "user_handle": { "$ref": "#/$defs/userHandle" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "credentialId": { "type": "string", "minLength": 22, "maxLength": 1366, "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3})?$" },
    "clientData": { "type": "string", "minLength": 1, "maxLength": 21846, "pattern": "^[A-Za-z0-9_-]+$" },
    "authenticatorData": { "type": "string", "minLength": 1, "maxLength": 5462, "pattern": "^[A-Za-z0-9_-]+$" },
    "signature": { "type": "string", "minLength": 1, "maxLength": 1366, "pattern": "^[A-Za-z0-9_-]+$" },
    "userHandle": { "type": "string", "minLength": 1, "maxLength": 86, "pattern": "^[A-Za-z0-9_-]+$" }
  }
}
