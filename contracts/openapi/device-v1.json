{
  "openapi": "3.1.0",
  "info": { "title": "AgentPass Device API", "version": "1.0.0", "description": "G4.0 freezes this contract. G4.1 implements the device-bound bundle response, correctness-fallback refresh polling, and signed ACK ingestion in the Cloud runtime with runtime and PostgreSQL conformance evidence. The G4.2 native daemon path is implemented locally and awaits real-boundary qualification; Console presentation remains G4.3 work." },
  "x-agentpass-implementation-status": { "contract": "frozen-g4.0", "bundle-fetch-target-envelope": "implemented-g4.1", "refresh-poll": "implemented-g4.1", "signed-ack-ingestion": "implemented-g4.1", "native-sync": "in-progress-g4.2", "console-device-state": "in-progress-g4.3" },
  "servers": [{ "url": "https://api.ai-agentpass.com/v1" }],
  "paths": {
    "/enrollments/{enrollment_id}": {
      "post": {
        "operationId": "completeDeviceEnrollment",
        "summary": "Complete a one-time device enrollment",
        "description": "Consumes the one-time enrollment credential and proof-of-possession, then returns the active device identity epoch and the two purpose-separated public trust roots required by the native client. The enrollment response never contains private key material or an enrollment credential. The response is no-store and includes a request_id envelope field.",
        "x-agentpass-browser-onboarding": {
          "preflight_schema": "../schemas/device-onboarding-preflight-v1.schema.json",
          "invitation_delivery_schema": "../schemas/device-onboarding-invitation-delivery-v1.schema.json",
          "possession_receipt_schema": "../schemas/device-possession-receipt-v1.schema.json",
          "trust_installation_ack_schema": "../schemas/device-trust-installation-ack-v1.schema.json",
          "control_ack_schema": "../schemas/bundle-ack-v1.schema.json",
          "authority_fields": "server-derived only; caller cannot select organization, device, authority generation, or trust roots",
          "secret_transport": "credential is one-shot in-memory delivery only and is forbidden in argv, environment, URL, and durable storage",
          "downgrade": "reject browser-led proof versions other than 2"
        },
        "security": [{ "enrollmentCredential": [], "enrollmentProof": [] }],
        "parameters": [{ "$ref": "#/components/parameters/EnrollmentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "../schemas/device-enrollment-v1.schema.json" },
                  { "$ref": "../schemas/device-enrollment-completion-v2.schema.json" }
                ],
                "discriminator": { "propertyName": "version" }
              }
            }
          }
        },
        "responses": {
          "201": { "$ref": "#/components/responses/DeviceEnrollmentCompleted" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/organizations/{organization_id}/devices/{device_id}/enrollment-receipt": {
      "get": {
        "operationId": "getDeviceEnrollmentPossessionReceipt",
        "summary": "Fetch the device-bound Cloud possession receipt",
        "description": "Returns the latest Cloud-signed possession receipt for exactly the device identified by both path parameters. The device signature authenticates the read and is bound to this exact tenant/device path. The receipt contains only candidate provenance, public-key fingerprint, key epoch, and signed hashes; it never contains a private key, enrollment credential, or raw challenge nonce. The response is no-store and redirects are forbidden.",
        "security": [{ "deviceSignature": [] }],
        "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }, { "$ref": "#/components/parameters/DeviceId" }],
        "x-agentpass-tenant-scope": { "kind": "organization", "source": "path.organization_id", "cross-tenant-disclosure": false, "additionalProperties": false },
        "x-agentpass-device-scope": { "kind": "device", "source": "path.device_id", "cross-device-disclosure": false, "additionalProperties": false },
        "x-agentpass-transport": { "redirects": "forbidden", "cache-control": "no-store", "additionalProperties": false },
        "responses": {
          "200": { "$ref": "#/components/responses/DeviceEnrollmentReceipt" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/organizations/{organization_id}/devices/{device_id}/agent-session-grants/{grant_id}/consume": {
      "post": {
        "operationId": "consumeAgentSessionGrant",
        "summary": "Consume a device-bound Agent Session Grant",
        "description": "Consumes exactly one Cloud-signed Agent Session Grant for the path organization and device and creates a process-bound Session Lease. The native service derives process_binding_sha256 from OS observations and the device signature authenticates that exact hash with the request. Grant identity, tenant, device, agent, grant_id, control_sequence, and authority_generation in the body/path must match before consumption; control_sequence and authority_generation are distinct bindings. An exact retry with the same grant and process binding returns the same committed lease; a changed grant or process binding, path substitution, replay, expiry, revocation, or conflicting consumption returns a stable conflict and never widens authority. The response is no-store and contains no private key or bearer session token.",
        "security": [{ "deviceSignature": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/GrantId" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ConsumeAgentSessionGrant" },
        "x-agentpass-contract-status": "frozen-m2",
        "x-agentpass-runtime-path": "/v1/organizations/{organization_id}/devices/{device_id}/agent-session-grants/{grant_id}/consume",
        "x-agentpass-tenant-scope": { "kind": "organization", "source": "path.organization_id + grant.statement.organization_id", "binding": "grant.statement.organization_id == path.organization_id", "cross-tenant-disclosure": false, "additionalProperties": false },
        "x-agentpass-device-scope": { "kind": "device", "source": "path.device_id + grant.statement.device_id + authenticated-device", "binding": "grant.statement.device_id == path.device_id == authenticated.device_id", "cross-device-disclosure": false, "additionalProperties": false },
        "x-agentpass-grant-binding": { "path_grant_id": "grant.statement.grant_id", "path_organization_id": "grant.statement.organization_id", "path_device_id": "grant.statement.device_id", "control_sequence": "grant.statement.control_sequence", "authority_generation": "grant.statement.authority_generation", "process_binding": "body.process_binding_sha256", "ancestry_binding": "body.ancestry_binding_sha256", "retry_identity": "grant.statement_hash + body.process_binding_sha256 + body.ancestry_binding_sha256", "consume": "one-time", "additionalProperties": false },
        "x-agentpass-authority": { "grant-schema": "../schemas/agent-session-grant-v1.schema.json", "lease-schema": "../schemas/agent-session-lease-v1.schema.json", "derived-bindings": ["control_sequence", "authority_generation"], "private-material": "never-accepted-or-returned", "additionalProperties": false },
        "x-agentpass-transport": { "redirects": "forbidden", "cache-control": "no-store", "additionalProperties": false },
        "responses": {
          "201": { "$ref": "#/components/responses/AgentSessionGrantConsumed" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/organizations/{organization_id}/devices/{device_id}/qualification-grant-batches/{batch_id}/claim": {
      "post": {
        "operationId": "claimQualificationGrantBatch",
