        "x-agentpass-tenant-scope": { "kind": "organization", "source": "path.organization_id + authenticated-device", "binding": "authenticated device belongs to path.organization_id", "cross-tenant-disclosure": false, "additionalProperties": false },
        "x-agentpass-device-scope": { "kind": "device", "source": "path.device_id + authenticated-device", "binding": "path.device_id == authenticated.device_id", "cross-device-disclosure": false, "additionalProperties": false },
        "x-agentpass-agent-session-scope": { "kind": "agent-session", "source": "path.session_id + server session record", "binding": "session is active and belongs to path organization/device", "cross-session-disclosure": false, "additionalProperties": false },
        "x-agentpass-request-binding": { "canonical-form": "canonical-json({request_id})", "digest": "sha256(UTF-8 canonical-form)", "idempotency-key": "body.request_id", "caller-authority-fields": [], "additionalProperties": false },
        "x-agentpass-authority": { "capability-schema": "../schemas/agent-signing-capability-v1.schema.json", "response-schema": "../schemas/agent-session-signing-capability-response-v1.schema.json", "signature-domain": "AgentPass-Agent-Signing-Capability-v1\u0000", "derived-fields": ["operation", "scope", "key_purpose", "key_id", "algorithm", "max_signatures", "one_use", "issued_at", "not_before", "expires_at", "sequence", "remaining_session_signatures", "control_sequence", "authority_generation"], "one-use": true, "private-material": "never-accepted-or-returned", "additionalProperties": false },
        "x-agentpass-idempotency": { "same-request-id-same-server-binding": "return-original-committed-result", "same-request-id-different-server-binding": "request_id_reused", "additionalProperties": false },
        "x-agentpass-transport": { "redirects": "forbidden", "cache-control": "no-store", "request-body-content-type": "application/json", "additionalProperties": false },
        "responses": {
