    }
  },
  "components": {
    "securitySchemes": {
      "deviceSignature": { "type": "apiKey", "in": "header", "name": "AgentPass-Signature", "description": "Authenticates the device request. The canonical signed request input is exactly six newline-delimited fields: UPPERCASE_METHOD\\nWHATWG_URL_PATHNAME\\nCANONICAL_RFC3986_QUERY\\nLOWERCASE_BODY_SHA256\\nUNIX_TIMESTAMP_MILLISECONDS\\nNONCE. The pathname is exactly the result of resolving the supplied absolute-path reference against a fixed HTTPS base and reading URL.pathname. Query parameters are decoded, RFC3986-encoded, and sorted by encoded key then value. The signature covers this exact UTF-8 input; redirects are never followed and signatures are never forwarded to another origin." },
      "humanSession": { "type": "apiKey", "in": "cookie", "name": "__Host-agentpass_session", "description": "Hosted Human session forwarded only by the same-origin Console BFF. The session must carry at least the auditor role for the path organization." },
      "auditReader": { "type": "http", "scheme": "bearer", "bearerFormat": "opaque", "description": "Evaluation-profile auditor credential. Hosted production uses humanSession instead. The organization and device path/query scope remains authoritative; a credential never widens either scope." },
      "enrollmentCredential": { "type": "apiKey", "in": "header", "name": "AgentPass-Enrollment-Credential", "description": "One-time 256-bit credential; only its SHA-256 digest is retained by the Control Plane." },
      "enrollmentProof": { "type": "apiKey", "in": "header", "name": "AgentPass-Enrollment-Signature", "description": "Raw 64-byte signature over the method, exact path, canonical request-body SHA-256, and enrollment-credential SHA-256." }
    },
    "parameters": {
      "EnrollmentId": { "name": "enrollment_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "OrganizationId": { "name": "organization_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "DeviceId": { "name": "device_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
      "GrantId": { "name": "grant_id", "in": "path", "required": true, "description": "Agent Session Grant identifier. The body statement.grant_id must exactly equal this path value.", "schema": { "type": "string", "format": "uuid" } },
      "AgentSessionId": { "name": "session_id", "in": "path", "required": true, "description": "Active Agent Session identifier. It is transport scope only; the caller cannot select or widen the operation, scope, key, lifetime, budget, or generations.", "schema": { "type": "string", "format": "uuid" } },
      "QualificationBatchId": { "name": "batch_id", "in": "path", "required": true, "description": "Qualification batch identifier. The manifest.statement.batch_id must exactly equal this path value.", "schema": { "type": "string", "format": "uuid" } },
      "AfterGeneration": { "name": "after_generation", "in": "query", "required": false, "description": "Return a hint only when a strictly newer committed authority generation exists. This is a cursor, not authority.", "schema": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 0 } },
      "WaitMs": { "name": "wait_ms", "in": "query", "required": false, "description": "Bounded long-poll wait duration in milliseconds.", "schema": { "type": "integer", "minimum": 0, "maximum": 30000, "default": 0 } },
      "AuditDeviceId": { "name": "device_id", "in": "query", "required": true, "description": "The single device stream to read. This scope is part of cursor authentication and cannot be changed while traversing a stream.", "schema": { "type": "string", "format": "uuid" } },
      "AuditCursor": { "name": "cursor", "in": "query", "required": false, "description": "Opaque, versioned, authenticated keyset cursor. It is bound to resource device-audit, organization_id, and device_id and contains the exclusive last-seen (device_timestamp, device_id, event_id) tuple plus an expiry. Clients must not inspect or modify it. Invalid, tampered, expired, cross-tenant, cross-device, or otherwise mismatched values return invalid_cursor.", "schema": { "$ref": "#/components/schemas/AuditCursor" } },
      "AuditLimit": { "name": "limit", "in": "query", "required": false, "description": "Maximum records returned. The server probes limit + 1 records to determine whether next_cursor is present.", "schema": { "type": "integer", "minimum": 1, "maximum": 500, "default": 100 } }
    },
    "requestBodies": {
      "ConsumeAgentSessionGrant": {
        "required": true,
        "description": "The body binds the exact Cloud-signed grant to the process and ancestry binding digests derived by the native service. No lease, raw process identity, audit token, PID, ancestry record, or second authority object is accepted.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionGrantConsumeRequest" } } }
      },
      "ClaimQualificationGrantBatch": {
        "required": true,
        "description": "Public candidate and release bindings for the batch claim. The batch_id, organization_id, and device_id are path/authentication bindings. No Grant, manifest, signature, private key, or nonce is accepted in the body.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QualificationGrantBatchClaimRequest" } } }
      },
      "IssueAgentSessionSigningCapability": {
        "required": true,
        "description": "Only the public request_id is accepted. Organization, device, and session are path/authentication bindings; operation, scope, signer purpose, key, algorithm, lifetime, budget, and generations are server-derived.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSigningCapabilityRequest" } } }
      }
    },
    "responses": {
      "Json": { "description": "JSON response", "content": { "application/json": { "schema": { "type": "object" } } } },
      "DeviceEnrollmentCompleted": { "description": "The one-time enrollment was consumed and the device is active. The response is no-store and contains no private key or enrollment credential.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceEnrollmentCompletedResponse" } } } },
      "DeviceEnrollmentReceipt": { "description": "A device-authenticated, Cloud-signed possession receipt. The response is no-store and contains no private key, enrollment credential, or raw challenge nonce.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DevicePossessionReceiptV1" } } } },
      "AgentSessionGrantConsumed": { "description": "The exact Agent Session Grant was consumed or recognized as an idempotent duplicate and a process-bound Session Lease was committed. The response is no-store and contains no private key or bearer session token.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionLeaseResponse" } } } },
      "AgentSessionSigningCapabilityIssued": { "description": "The exact Device-authenticated Agent Session request was committed or recognized as an exact retry. The response contains one canonical Cloud-signed, one-use signing capability and safe public metadata only; it is no-store and must not be obtained through a redirect.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AgentSessionSigningCapabilityResponse" } } } },
      "QualificationGrantBatchClaimed": { "description": "The exact device-bound qualification batch was claimed or recognized as an exact retry. The response is no-store, contains one purpose-separated Ed25519 manifest with exactly seven ordered steps, and embeds only the unchanged Agent Session Grant v1 envelopes; it contains no private key or bearer token.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QualificationGrantBatchClaimResponse" } } } },
      "ControlRefreshPoll": { "description": "A newer device-bound refresh hint. The hint accelerates a bundle fetch but cannot authorize or extend expiry. The response is no-store and includes a request_id envelope field.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ControlRefreshPollResponse" } } } },
      "ControlBundleFetch": { "description": "The exact signed ControlBundle v2 for the path organization and device. The response is no-store and must not be obtained through a redirect. It includes a request_id envelope field.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ControlBundleFetchResponse" } } } },
      "ControlBundleAcknowledgementAccepted": { "description": "The exact acknowledgement was accepted or recognized as an idempotent duplicate. The response is no-store and includes a request_id envelope field.", "headers": { "Cache-Control": { "$ref": "#/components/headers/CacheControl" }, "X-RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }, "X-RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }, "X-RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ControlBundleAcknowledgementResponse" } } } },
      "DeviceAuditList": { "description": "A bounded, tenant/device-scoped audit page.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceAuditListResponse" } } } },
      "InvalidCursor": { "description": "The cursor is malformed, tampered, expired, or bound to another tenant/device/resource.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/InvalidCursorEnvelope" } } } },
      "BadRequest": { "description": "Stable 400 error for malformed, out-of-range, or body/path-inconsistent input.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "Unauthorized": { "description": "Authentication is required or invalid.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "NotFound": { "description": "Stable 404 error for an absent or unavailable organization/device resource without cross-tenant disclosure.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "Conflict": { "description": "Stable 409 error for an acknowledgement that conflicts with already observed device evidence.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "RateLimited": { "description": "Stable 429 error when the device polling or acknowledgement rate limit is exceeded.", "headers": { "Retry-After": { "description": "Seconds before retrying.", "required": false, "schema": { "type": "integer", "minimum": 0 } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "ServiceUnavailable": { "description": "Stable 503 error when the control-plane dependency is unavailable; no authority is widened by retry behavior.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } },
      "Forbidden": { "description": "The authenticated auditor cannot read this organization/device scope.", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } } }
    },
    "schemas": {
      "ScopeV1": { "$ref": "../schemas/scope-v1.schema.json" },
      "BundleAckV1": { "$ref": "../schemas/bundle-ack-v1.schema.json" },
      "OnboardingControlAckV1": { "$ref": "../schemas/bundle-ack-v1.schema.json" },
      "RefreshHintV1": { "$ref": "../schemas/refresh-hint-v1.schema.json" },
      "DeviceEnrollmentCompletionV2": { "$ref": "../schemas/device-enrollment-completion-v2.schema.json" },
      "DevicePossessionReceiptV1": { "$ref": "../schemas/device-possession-receipt-v1.schema.json" },
      "DeviceOnboardingPreflightV1": { "$ref": "../schemas/device-onboarding-preflight-v1.schema.json" },
      "DeviceOnboardingInvitationDeliveryV1": { "$ref": "../schemas/device-onboarding-invitation-delivery-v1.schema.json" },
      "DeviceTrustInstallationAcknowledgementV1": { "$ref": "../schemas/device-trust-installation-ack-v1.schema.json" },
      "AgentSessionGrantV1": { "$ref": "../schemas/agent-session-grant-v1.schema.json" },
      "AgentSessionLeaseV1": { "$ref": "../schemas/agent-session-lease-v1.schema.json" },
      "AgentSigningCapabilityV1": { "$ref": "../schemas/agent-signing-capability-v1.schema.json" },
      "AgentSessionSigningCapabilityRequest": { "$ref": "../schemas/agent-session-signing-capability-request-v1.schema.json" },
      "AgentSessionSigningCapabilityResponse": { "$ref": "../schemas/agent-session-signing-capability-response-v1.schema.json" },
      "QualificationGrantBatchClaimRequest": { "$ref": "../schemas/qualification-grant-batch-claim-v1.schema.json" },
      "QualificationGrantBatchManifestV1": { "$ref": "../schemas/qualification-grant-batch-manifest-v1.schema.json" },
      "AgentSessionGrantConsumeRequest": {
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": ["grant", "process_binding_sha256", "ancestry_binding_sha256"],
        "properties": {
          "grant": { "$ref": "#/components/schemas/AgentSessionGrantV1" },
          "process_binding_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
          "ancestry_binding_sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
        }
      },
      "DeviceRefreshState": { "type": "string", "enum": ["pending", "fetching", "applied", "blocked", "stale", "offline", "revoked"] },
      "ControlBundleAudience": {
        "type": "object",
        "additionalProperties": false,
        "required": ["organization_id", "device_id"],
        "properties": {
          "organization_id": { "type": "string", "format": "uuid" },
          "device_id": { "type": "string", "format": "uuid" }
        }
      },
      "ControlBundleV2": { "$ref": "../schemas/control-bundle-v2.schema.json" },
      "RequestId": { "type": "string", "format": "uuid", "description": "Server-generated correlation identifier added to every non-204 response." },
      "DeviceEnrollmentControlTrust": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format_epoch", "issuer", "key_id", "public_key", "bundle_path", "refresh_hint"],
        "properties": {
          "format_epoch": { "const": 2 },
          "issuer": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "key_id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "public_key": { "type": "string", "minLength": 80, "maxLength": 8192, "pattern": "^-----BEGIN PUBLIC KEY-----" },
          "bundle_path": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/v1/organizations/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/bundles/[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
          "refresh_hint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key_id", "algorithm", "public_key"],
            "properties": {
              "key_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
              "algorithm": { "const": "ed25519" },
              "public_key": { "type": "string", "minLength": 80, "maxLength": 8192, "pattern": "^-----BEGIN PUBLIC KEY-----" }
            }
          }
        }
      },
      "DeviceEnrollmentCompleted": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "enrollment_id", "organization_id", "device_id", "status", "key_algorithm", "device_key_epoch", "control"],
        "properties": {
          "version": { "const": 1 },
          "enrollment_id": { "type": "string", "format": "uuid" },
          "organization_id": { "type": "string", "format": "uuid" },
          "device_id": { "type": "string", "format": "uuid" },
          "status": { "const": "active" },
          "key_algorithm": { "enum": ["p256-sha256", "ed25519"] },
          "device_key_epoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "control": { "$ref": "#/components/schemas/DeviceEnrollmentControlTrust" }
        }
      },
      "DeviceEnrollmentCompletedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enrollment", "request_id"],
        "properties": {
          "enrollment": { "$ref": "#/components/schemas/DeviceEnrollmentCompleted" },
          "request_id": { "$ref": "#/components/schemas/RequestId" }
        }
      },
      "AgentSessionLeaseResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lease", "request_id"],
        "properties": {
          "lease": { "$ref": "#/components/schemas/AgentSessionLeaseV1" },
          "request_id": { "$ref": "#/components/schemas/RequestId" }
        }
      },
      "QualificationGrantBatchClaimResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["batch", "request_id"],
        "properties": {
          "batch": { "$ref": "#/components/schemas/QualificationGrantBatchManifestV1" },
          "request_id": { "$ref": "#/components/schemas/RequestId" }
        }
      },
      "ControlRefreshPollResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hint", "request_id"],
        "properties": { "hint": { "$ref": "#/components/schemas/RefreshHintV1" }, "request_id": { "$ref": "#/components/schemas/RequestId" } }
      },
      "ControlBundleFetchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle", "desired_generation", "request_id"],
        "properties": {
          "bundle": { "$ref": "#/components/schemas/ControlBundleV2" },
          "desired_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "request_id": { "$ref": "#/components/schemas/RequestId" }
        }
      },
      "ControlBundleAcknowledgementResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted", "duplicate", "observed_generation", "refresh_state", "request_id"],
        "properties": {
          "accepted": { "const": true },
          "duplicate": { "type": "boolean" },
          "observed_generation": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "refresh_state": { "$ref": "#/components/schemas/DeviceRefreshState" },
          "request_id": { "$ref": "#/components/schemas/RequestId" }
        }
      },
      "AuditCursor": { "$ref": "../schemas/device-audit-list-v1.schema.json#/$defs/cursor" },
      "DeviceAuditListResponse": { "$ref": "../schemas/device-audit-list-v1.schema.json" },
      "ErrorEnvelope": { "type": "object", "additionalProperties": false, "required": ["error", "request_id"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 64 }, "message": { "type": "string", "minLength": 1, "maxLength": 512 } } }, "request_id": { "type": "string", "format": "uuid" } } },
      "InvalidCursorEnvelope": { "type": "object", "additionalProperties": false, "required": ["error", "request_id"], "properties": { "error": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "const": "invalid_cursor" }, "message": { "type": "string", "const": "Cursor is invalid" } } }, "request_id": { "$ref": "#/components/schemas/RequestId" } } }
    },
    "headers": {
      "CacheControl": { "description": "Responses must not be cached.", "required": true, "schema": { "type": "string", "const": "no-store" } },
      "RateLimitLimit": { "description": "Configured rate-limit capacity.", "required": true, "schema": { "type": "string", "pattern": "^[1-9][0-9]*$" } },
      "RateLimitRemaining": { "description": "Remaining requests in the current rate-limit window.", "required": true, "schema": { "type": "string", "pattern": "^[0-9]+$" } },
      "RateLimitReset": { "description": "Unix epoch seconds at which the rate-limit window resets.", "required": true, "schema": { "type": "string", "pattern": "^[0-9]+$" } }
    }
  }
}
