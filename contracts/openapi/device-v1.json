        "description": "Claims exactly one operator-authorized qualification batch for the authenticated device and the organization, device, and batch identifiers in the path. The device signature authenticates the exact raw request before the claim body is interpreted. A successful response contains one purpose-separated Ed25519 qualification manifest whose statement contains exactly seven ordered steps, each with an unchanged Agent Session Grant v1 envelope. The claim is one-shot with an exact retry identity; path, candidate, release, team, expiry, manifest signature, Grant signature, or step substitutions fail closed. The response is no-store and redirects are forbidden.",
        "security": [{ "deviceSignature": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/QualificationBatchId" }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/ClaimQualificationGrantBatch" },
        "x-agentpass-contract-status": "frozen-qualification-batch-v1",
        "x-agentpass-runtime-path": "/v1/organizations/{organization_id}/devices/{device_id}/qualification-grant-batches/{batch_id}/claim",
        "x-agentpass-tenant-scope": { "kind": "organization", "source": "path.organization_id + manifest.statement.organization_id", "binding": "manifest.statement.organization_id == path.organization_id", "cross-tenant-disclosure": false, "additionalProperties": false },
        "x-agentpass-device-scope": { "kind": "device", "source": "path.device_id + manifest.statement.device_id + authenticated-device", "binding": "manifest.statement.device_id == path.device_id == authenticated.device_id", "cross-device-disclosure": false, "additionalProperties": false },
        "x-agentpass-batch-binding": { "path_batch_id": "manifest.statement.batch_id", "candidate_bindings": ["candidate_sha256", "artifact_sha256", "source_commit", "team_id", "release_trust_sha256", "candidate_checkpoint_sha256"], "step_count": 7, "step_order": "fixed", "claim": "one-shot with exact retry", "additionalProperties": false },
        "x-agentpass-authority": { "manifest-schema": "../schemas/qualification-grant-batch-manifest-v1.schema.json", "manifest-type": "agentpass.qualification-grant-batch-manifest", "signature-algorithm": "ed25519", "signature-purpose": "agentpass.qualification-grant-batch-manifest", "grant-schema": "../schemas/agent-session-grant-v1.schema.json", "grant-envelope": "unchanged", "private-material": "never-accepted-or-returned", "additionalProperties": false },
        "x-agentpass-transport": { "redirects": "forbidden", "cache-control": "no-store", "additionalProperties": false },
        "responses": {
          "200": { "$ref": "#/components/responses/QualificationGrantBatchClaimed" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/organizations/{organization_id}/devices/{device_id}/agent-sessions/{session_id}/signing-capabilities": {
      "post": {
        "operationId": "issueAgentSessionSigningCapability",
        "summary": "Issue one server-scoped, one-use Agent Session signing capability",
        "description": "The authenticated Device requests one capability for the exact organization, device, and active Agent Session in the path. The JSON body contains only a public request_id. Operation, scope, signer purpose, key, algorithm, lifetime, one-use budget, capability sequence, control sequence, and authority generation are resolved and signed by the server; caller-supplied authority fields, downgrade versions, cross-tenant/device/session substitutions, and replay or conflicting request identities fail closed. An exact retry returns the same committed public result without issuing a second capability. The response is no-store and contains no private key, bearer token, provider diagnostic, or raw device credential.",
        "security": [{ "deviceSignature": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/OrganizationId" },
          { "$ref": "#/components/parameters/DeviceId" },
          { "$ref": "#/components/parameters/AgentSessionId" }
