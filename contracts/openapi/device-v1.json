        ],
        "x-agentpass-tenant-scope": { "kind": "organization", "source": "path.organization_id", "cross-tenant-disclosure": false },
        "x-agentpass-device-scope": { "kind": "device", "source": "query.device_id", "cross-device-disclosure": false },
        "x-agentpass-ordering": ["device_timestamp", "device_id", "event_id"],
