{
  "openapi": "3.1.0",
  "info": { "title": "AgentPass Human API", "version": "1.0.0" },
  "servers": [{ "url": "https://app.ai-agentpass.com/api/v1" }],
  "paths": {
    "/auth/github/start": { "post": { "operationId": "startGithubAuthorization", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/auth/github/callback": { "post": { "operationId": "completeGithubAuthorization", "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/auth/logout": { "post": { "operationId": "logout", "security": [{ "humanSession": [] }], "responses": { "204": { "description": "Session revoked" } } } },
    "/auth/management/credentials": { "get": { "operationId": "listWebAuthnCredentials", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/auth/management/credentials/{credential_id}": { "patch": { "operationId": "renameWebAuthnCredential", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/auth/management/credentials/{credential_id}/revoke": { "post": { "operationId": "revokeWebAuthnCredential", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/auth/management/sessions": { "get": { "operationId": "listHumanSessions", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/auth/management/sessions/{session_id}/revoke": { "post": { "operationId": "revokeHumanSession", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/webauthn/registration/options": { "post": { "operationId": "createRegistrationOptions", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/webauthn/registration/verify": { "post": { "operationId": "verifyRegistration", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/webauthn/authentication/options": { "post": { "operationId": "createAuthenticationOptions", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/webauthn/authentication/verify": { "post": { "operationId": "verifyAuthentication", "security": [{ "humanSession": [] }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/organizations": { "post": { "operationId": "createOrganization", "security": [{ "humanSession": [] }], "responses": { "201": { "$ref": "#/components/responses/Json" } } } },
    "/organizations/{organization_id}": { "get": { "operationId": "getOrganization", "security": [{ "humanSession": [] }], "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/organizations/{organization_id}/members": { "get": { "operationId": "listMembers", "security": [{ "humanSession": [] }], "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }], "responses": { "200": { "$ref": "#/components/responses/Json" } }, "x-agentpass-minimum-role": "admin" }, "post": { "operationId": "addMember", "security": [{ "humanSession": [] }], "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }], "responses": { "201": { "$ref": "#/components/responses/Json" } }, "x-agentpass-minimum-role": "admin" } },
    "/organizations/{organization_id}/devices": { "get": { "operationId": "listDevices", "security": [{ "humanSession": [] }], "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }], "responses": { "200": { "$ref": "#/components/responses/Json" } } } },
    "/organizations/{organization_id}/device-enrollments": { "post": { "operationId": "issueDeviceEnrollment", "security": [{ "humanSession": [], "recentWebAuthn": [] }], "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }], "responses": { "201": { "$ref": "#/components/responses/Json" } }, "x-agentpass-minimum-role": "admin" } },
    "/organizations/{organization_id}/emergency-stop": { "post": { "operationId": "emergencyStop", "security": [{ "humanSession": [], "recentWebAuthn": [] }], "parameters": [{ "$ref": "#/components/parameters/OrganizationId" }], "responses": { "201": { "$ref": "#/components/responses/Json" } }, "x-agentpass-minimum-role": "owner" } }
  },
  "components": {
    "securitySchemes": {
      "humanSession": { "type": "apiKey", "in": "cookie", "name": "__Host-agentpass_session" },
      "recentWebAuthn": { "type": "apiKey", "in": "header", "name": "AgentPass-Recent-Auth" }
    },
    "parameters": { "OrganizationId": { "name": "organization_id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } },
    "responses": { "Json": { "description": "JSON response", "content": { "application/json": { "schema": { "type": "object" } } } } }
  }
}
