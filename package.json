{
  "name": "agentpass",
  "version": "0.18.0",
  "description": "Policy-controlled signing broker for coding agents",
  "type": "module",
  "files": [
    "bin",
    "lib",
    "packages/protocol",
    "packages/capability",
    "adapters/mcp-server",
    "apps/cloud-api",
    "contracts",
    "docs",
    "ops",
    "native/macos/Package.swift",
    "native/macos/Resources",
    "native/macos/scripts",
    "scripts/release",
    "scripts/qualification",
    "scripts/owner-recovery",
    "scripts/postgres",
    "native/macos/Sources",
    "native/macos/Tests",
    "README.md",
    "SECURITY.md",
    "THREAT_MODEL.md",
    "LICENSE"
  ],
  "bin": {
    "agentpass": "./bin/agentpass.mjs",
    "agentpassd": "./bin/agentpassd.mjs",
    "agentpass-git-sign": "./bin/agentpass-git-sign.mjs",
    "agentpass-pre-push": "./bin/agentpass-pre-push.mjs",
    "agentpass-anchor": "./bin/agentpass-anchor.mjs",
    "agentpass-mcp": "./adapters/mcp-server/bin/agentpass-mcp.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs test/support/p0b/*.test.mjs packages/*/test/*.test.mjs adapters/*/test/*.test.mjs apps/cloud-api/test/*.test.mjs apps/cloud-api/test/human-auth/*.test.mjs apps/cloud-api/test/postgres/*.test.mjs scripts/qualification/*.test.mjs scripts/owner-recovery/*.test.mjs scripts/p0b/*.test.mjs scripts/p0b/qualification/*.test.mjs scripts/release/p0c/drivers/*.test.mjs scripts/release/p0c/scenarios/*.test.mjs scripts/release/n3e/*.test.mjs",
    "test:native": "node scripts/ci/run-native-tests.mjs -- swift test --package-path native/macos --no-parallel",
    "test:native-app": "native/macos/scripts/test-app-bundle.sh",
    "test:native-installer-preservation": "native/macos/scripts/test-installer-preservation.sh",
    "test:native-durability-model": "node native/macos/scripts/qualification/g42-posix-kill-restart.mjs",
    "test:n3e:packaging": "node --test scripts/release/n3e/packaging.test.mjs",
    "test:postgres:g4": "node --test apps/cloud-api/test/postgres/g4-refresh-integration.test.mjs apps/cloud-api/test/postgres/g4-refresh-contention-integration.test.mjs apps/cloud-api/test/postgres/g4-1-refresh-nonce-rotation-integration.test.mjs apps/cloud-api/test/postgres/g4-1-process-kill-qualification.test.mjs apps/cloud-api/test/postgres/g4-1-propagation-postgres-qualification.test.mjs apps/cloud-api/test/postgres/p0b-signed-ack.integration.test.mjs",
    "test:postgres:w15": "node --test --test-concurrency=1 apps/cloud-api/test/postgres/owner-recovery-provider-acceptance.integration.test.mjs apps/cloud-api/test/postgres/owner-recovery-provider-confirmation.integration.test.mjs apps/cloud-api/test/postgres/owner-recovery-outbox-race-matrix.integration.test.mjs apps/cloud-api/test/postgres/owner-recovery-process-loss-qualification.integration.test.mjs",
    "test:postgres:w15:composed": "node --test --test-concurrency=1 apps/cloud-api/test/postgres/owner-recovery-https-provider-composed.integration.test.mjs apps/cloud-api/test/postgres/owner-recovery-retention-confirmation-races.integration.test.mjs",
    "test:w16": "node scripts/owner-recovery/validate-w16-alerts.mjs \"$PWD/ops/observability/owner-recovery-alerts.v1.json\" && node --test scripts/owner-recovery/validate-w16-alerts.test.mjs scripts/owner-recovery/verify-w16-drill-evidence.test.mjs",
    "test:p0b:live": "node scripts/p0b/run-live-process.mjs",
    "release:validate": "node scripts/release/validate-version.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "release:sign": "node scripts/release/sign-manifest.mjs",
    "release:verify": "node scripts/release/verify-release.mjs",
    "release:deployment-gate": "node scripts/release/deployment-gate.mjs",
    "release:database-schema-evidence": "node scripts/release/database-schema-evidence.mjs",
    "release:cutover-evidence": "node scripts/release/cutover-evidence.mjs",
    "release:derive-deployment-identity": "node scripts/release/derive-deployment-identity.mjs",
    "release:trust-sign": "node scripts/release/sign-deployment-trust.mjs",
    "release:workflow-validate": "node scripts/release/validate-promotion-workflow.mjs .github/workflows/promote-qualified-release.yml",
    "contracts:validate": "node scripts/validate-contracts.mjs",
    "qualification:platform-auth-config": "node scripts/qualification/validate-platform-auth-config.mjs",
    "qualification:platform-auth": "node scripts/qualification/platform-auth.mjs",
    "qualification:platform-auth:external": "node scripts/qualification/run-platform-auth-qualification.mjs",
    "qualification:postgres-c3:external": "node scripts/qualification/run-postgres-c3-external.mjs",
    "qualification:postgres-gate:aggregate": "node scripts/qualification/aggregate-postgres-external.mjs",
    "qualification:webauthn:external": "node scripts/qualification/run-webauthn-external.mjs",
    "qualification:kms": "node scripts/qualification/cloud-signer-kms.mjs",
    "qualification:kms:external": "node scripts/qualification/run-kms-qualification.mjs",
    "qualification:webauthn": "node scripts/qualification/run-webauthn-e2e.mjs",
    "qualification:postgres-c3": "node scripts/qualification/postgres-c3-migration-0047.mjs",
    "qualification:external": "node scripts/release/ci-preflight.mjs external-qualification",
    "postgres:cutover": "node scripts/postgres/cutover.mjs",
    "postgres:authority-manifest": "node scripts/postgres/authority-manifest.mjs",
    "lint": "node --check bin/*.mjs && node --check lib/*.mjs && node --check packages/*/src/*.mjs && node --check adapters/*/src/*.mjs && node --check adapters/*/bin/*.mjs && node --check apps/cloud-api/src/*.mjs apps/cloud-api/src/human-auth/*.mjs apps/cloud-api/src/human-auth/agent-sessions/*.mjs apps/cloud-api/src/human-auth/identity/*.mjs apps/cloud-api/src/human-auth/management/*.mjs apps/cloud-api/src/human-auth/organizations/*.mjs apps/cloud-api/src/human-auth/pagination/*.mjs apps/cloud-api/src/human-auth/recovery/*.mjs apps/cloud-api/src/human-auth/webauthn/*.mjs apps/cloud-api/src/postgres/*.mjs && node --check scripts/*.mjs scripts/owner-recovery/*.mjs scripts/postgres/*.mjs scripts/release/*.mjs scripts/release/n3e/*.mjs scripts/release/p0c/lib/*.mjs scripts/release/p0c/drivers/* scripts/release/p0c/scenarios/* scripts/p0b/*.mjs scripts/p0b/postgres-tls/*.mjs scripts/p0b/qualification/*.mjs && bash -n native/macos/scripts/*.sh scripts/release/*.sh",
    "prepack": "npm run release:validate && npm run contracts:validate && npm run test:w16 && npm test && npm run test:native && npm run test:native-app && npm run test:native-installer-preservation && npm run test:native-durability-model && npm run lint"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Torutesu/AIagentpass.git"
  },
  "bugs": {
    "url": "https://github.com/Torutesu/AIagentpass/issues"
  },
  "homepage": "https://github.com/Torutesu/AIagentpass#readme",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-kms": "3.1110.0",
    "@google-cloud/kms": "6.0.0",
    "@simplewebauthn/server": "13.3.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1"
  }
}
