{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/schemas/hardware-qualification-v1.json",
  "title": "AgentPass hardware qualification result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_sha256", "architecture", "hardware_class", "model_identifier", "macos_version", "macos_build", "secure_enclave", "started_at", "completed_at", "operator", "qualified", "tests"],
  "properties": {
    "schema_version": { "const": 1 },
    "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "architecture": { "enum": ["arm64", "x86_64"] },
    "hardware_class": { "enum": ["apple_silicon", "intel_t2", "intel_without_t2"] },
    "model_identifier": { "type": "string", "minLength": 1 },
    "macos_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
    "macos_build": { "type": "string", "minLength": 1 },
    "secure_enclave": { "const": true },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "operator": { "type": "string", "minLength": 1 },
    "qualified": { "type": "boolean" },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/test" } }
  },
  "$defs": { "test": { "type": "object", "additionalProperties": false, "required": ["name", "status"], "properties": { "name": { "type": "string", "minLength": 1 }, "status": { "enum": ["passed", "failed", "skipped"] }, "reason": { "type": "string" }, "evidence": { "type": "string" } } } }
}
