  if (typeof observe !== 'function' || typeof clock !== 'function' || typeof waitFn !== 'function' || !Number.isSafeInteger(maxWaitMs) || maxWaitMs <= 0 || !Number.isSafeInteger(pollMs) || pollMs <= 0) throw new Error('expiry wait contract is invalid');
