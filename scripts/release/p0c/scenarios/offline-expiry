export const executeOfflineExpiry = (options) => executePhysicalScenario({ gate: GATE, tests: TESTS, ...options, execute: (context) => performOfflineExpiry(context) });
if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) await runPhysicalScenario({ gate: GATE, tests: TESTS, execute: (context) => performOfflineExpiry(context) });
