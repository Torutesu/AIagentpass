  return withCheckpoint(join(machine.checkpointDirectory, 'candidate-checkpoint.json'), async () => {
    const baseline = status(await runPinned(machine.executables.native_client, ['--service', SERVICE_LABEL, 'control-status'], { production, runCommand }), 'baseline control status');
    if (!await sign(runPinned, machine.executables.native_client, request, production, runCommand, 'baseline signing operation')) throw new Error('baseline signing operation was not allowed');
    const refreshed = refresh(await runPinned(machine.executables.native_client, ['--service', SERVICE_LABEL, 'control-refresh'], { production, runCommand }), 'online control refresh');
    if (refreshed.sequence !== baseline.sequence || refreshed.refresh_sequence !== baseline.sequence || refreshed.refresh_generation < baseline.refresh_generation) throw new Error('offline grant was not bounded to the converged control');

    let expired;
    try {
      await controlNetwork(false);
      expired = await waitForRealExpiry({ clock, waitFn, maxWaitMs, pollMs, observe: async () => status(await runPinned(machine.executables.native_client, ['--service', SERVICE_LABEL, 'control-status'], { production, runCommand }), 'offline expiry observation', true) });
