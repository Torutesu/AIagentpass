const exactKeys = (value, keys, label) => { if (!value || typeof value !== 'object' || Array.isArray(value) || JSON.stringify(Object.keys(value).sort()) !== JSON.stringify([...keys].sort())) throw new Error(`${label} has missing or unknown fields`); };
const requireRoot = (getUid = process.getuid) => { if (typeof getUid !== 'function' || getUid() !== 0) throw new Error('physical scenario requires root'); };
const outer = (result, label, allowFailure = false) => {
  const bytes = requireCommandSuccess(result, label);
  const value = parseJSONOutput(bytes, label);
