#!/usr/bin/env node
import { pathToFileURL } from 'node:url';
import { resolve, join } from 'node:path';
import { withVerifiedCandidateCheckpoint } from '../lib/candidate-checkpoint.mjs';
import { executePhysicalScenario, parseJSONOutput, readProtectedFile, requireCommandSuccess, runFixedCommand, runPinnedExecutable, runPhysicalScenario } from '../lib/scenario-runtime.mjs';

const GATE = 'offline-expiry';
const TESTS = Object.freeze(['offline-expiry-denied']);
const APP_PATH = '/Applications/AgentPass.app';
const SERVICE_LABEL = 'dev.agentpass.native-service';
const SIGNING_REQUEST_PATH = '/private/var/db/agentpass-qualification/signing-request.json';
const NETWORKSETUP = '/usr/sbin/networksetup';
const NETWORK_ARGS = Object.freeze(['-setnetworkserviceenabled', 'Wi-Fi']);
