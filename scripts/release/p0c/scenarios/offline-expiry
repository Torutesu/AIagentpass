export const performOfflineExpiry = async ({ release, machine, production = true, runCommand = runFixedCommand, runPinned = runPinnedExecutable, getUid = process.getuid, withCheckpoint = withVerifiedCandidateCheckpoint, signingRequest, networkControl, clock, waitFn, maxWaitMs, pollMs } = {}) => {
  requireRoot(getUid);
