  if (value.ok !== true) { if (allowFailure && typeof value.error === 'string' && value.stdout_base64 === null) return null; throw new Error(`${label} failed ambiguously`); }
  if (value.error !== null || typeof value.stdout_base64 !== 'string') throw new Error(`${label} envelope is invalid`);
  const decoded = Buffer.from(value.stdout_base64, 'base64'); if (decoded.length === 0 || decoded.toString('base64') !== value.stdout_base64) throw new Error(`${label} payload is invalid`);
  return decoded;
};
const validateStatus = (value, label, expiredAllowed = false) => {
  exactKeys(value, STATUS_KEYS, `${label} status`);
  if (value.configured !== true || value.format_epoch !== 2 || value.global_revoked !== false || value.device_revoked !== false || !Number.isSafeInteger(value.sequence) || value.sequence < 1 || !Number.isSafeInteger(value.refresh_generation) || value.refresh_generation < 1 || value.refresh_in_flight !== false || value.refresh_configured !== true || !['idle', 'acknowledged'].includes(value.refresh_state) || value.refresh_consecutive_failures !== 0 || !Array.isArray(value.revoked_agents) || !Array.isArray(value.revoked_capabilities) || (!expiredAllowed && (value.operational !== true || value.expired !== false))) throw new Error(`${label} status is invalid`);
  return value;
};
const status = (result, label, expiredAllowed = false) => validateStatus(parseJSONOutput(outer(result, label), label), label, expiredAllowed);
const refresh = (result, label) => { const value = parseJSONOutput(outer(result, label), label); exactKeys(value, [...STATUS_KEYS, 'refreshed'], `${label} status`); if (value.refreshed !== true) throw new Error(`${label} did not complete`); const { refreshed: _marker, ...body } = value; return validateStatus(body, label); };
