  const result = await runPinned(entry, ['--service', SERVICE_LABEL, 'sign'], { production, runCommand, input: request });
  try {
    const decoded = outer(result, label);
    if (decoded.length === 0) throw new Error(`${label} returned an empty signature`);
    return true;
