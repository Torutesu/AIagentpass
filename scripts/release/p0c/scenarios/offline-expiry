    if (recovered.sequence !== baseline.sequence || recovered.refresh_sequence !== baseline.sequence || recovered.operational !== true || recovered.expired !== false || recovered.refresh_generation < baseline.refresh_generation) throw new Error('control recovery widened or changed the bound policy');
