    v,
    [
      "artifact_sha256",
      "config_sha256",
      "key_fingerprint",
      "notarization_ticket_sha256",
      "package_id",
      "package_sha256",
      "schema_version",
      "source_commit",
      "team_id",
    ],
    "previous upgrade config",
