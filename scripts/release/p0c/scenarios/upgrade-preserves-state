    v.schema_version !== 1 ||
    config_sha256 !== hash(canonicalJSON(body)) ||
    v.package_sha256 !== pkgHash ||
    !DIGEST.test(v.artifact_sha256) ||
    !DIGEST.test(config_sha256) ||
    !DIGEST.test(v.package_sha256) ||
    !DIGEST.test(v.notarization_ticket_sha256) ||
