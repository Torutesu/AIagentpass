#!/usr/bin/env node

import fs from 'node:fs';
import { pathToFileURL } from 'node:url';
import { resolve } from 'node:path';
import { join } from 'node:path';
import { withVerifiedCandidateCheckpoint } from '../lib/candidate-checkpoint.mjs';
import {
  executePhysicalScenario,
  requireCommandSuccess,
  runFixedCommand,
  runPinnedExecutable,
  runPhysicalScenario,
} from '../lib/scenario-runtime.mjs';

const GATE = 'clean-install-launchd-xpc';
const TESTS = Object.freeze(['launchd-xpc-approval']);
const APP_PATH = '/Applications/AgentPass.app';
const SERVICE_LABEL = 'dev.agentpass.native-service';
const CLIENT_BUNDLE = `${APP_PATH}/Contents/Library/HelperTools/AgentPassNativeClient.app`;
const CLIENT_BINARY = `${CLIENT_BUNDLE}/Contents/MacOS/agentpass-native-client`;
const SERVICE_BUNDLE = `${APP_PATH}/Contents/Library/HelperTools/AgentPassNativeService.app`;
const SERVICE_BINARY = `${SERVICE_BUNDLE}/Contents/MacOS/agentpass-native-service`;
const LAUNCHCTL = '/bin/launchctl';
const CODESIGN = '/usr/bin/codesign';
const TEAM_ID_PATTERN = /^[A-Z0-9]{10}$/u;

const zero = (value) => value === 0 || value === 0n;

const requireRoot = (getUid = process.getuid) => {
  if (typeof getUid !== 'function' || getUid() !== 0) throw new Error('physical scenario requires root');
};

const requireProtectedPath = (fileSystem, path, kind) => {
  let stat;
  try {
    stat = fileSystem.lstatSync(path);
  } catch {
    throw new Error('installed application component is unavailable');
  }
  const isExpectedType = kind === 'directory' ? stat.isDirectory() : stat.isFile();
  if (!isExpectedType || stat.isSymbolicLink() || !zero(stat.uid) || !zero(stat.gid) || stat.nlink !== 1 || (Number(stat.mode) & 0o022) !== 0) {
    throw new Error('installed application component ownership or mode is unsafe');
  }
};

const runAndRequire = async (runCommand, command, args) => requireCommandSuccess(await runCommand(command, args, { cwd: '/' }), command);

const verifyTeamIdentifier = (result, expectedTeamId) => {
  const output = Buffer.concat([result.stdout ?? Buffer.alloc(0), result.stderr ?? Buffer.alloc(0)]).toString('utf8');
  const identifiers = [...output.matchAll(/^TeamIdentifier=([A-Z0-9]{10})$/gmu)].map((match) => match[1]);
  if (!TEAM_ID_PATTERN.test(expectedTeamId) || identifiers.length !== 1 || identifiers[0] !== expectedTeamId) throw new Error('code signature TeamIdentifier mismatch');
};

const verifySignedPath = async (runCommand, path, teamId) => {
  await runAndRequire(runCommand, CODESIGN, ['--verify', '--strict', '--verbose=2', path]);
  const details = await runCommand(CODESIGN, ['-dv', '--verbose=4', path], { cwd: '/' });
  requireCommandSuccess(details, CODESIGN);
  verifyTeamIdentifier(details, teamId);
};

export const performCleanInstallLaunchdXpc = async ({ release, machine, production = true, runCommand = runFixedCommand, runPinned = runPinnedExecutable, fileSystem = fs, getUid = process.getuid, withCheckpoint = withVerifiedCandidateCheckpoint } = {}) => {
  requireRoot(getUid);
  if (machine.applicationPath !== APP_PATH || machine.serviceLabel !== SERVICE_LABEL) throw new Error('scenario config identity is not fixed');
  if (machine.executables.native_client.path !== CLIENT_BINARY) throw new Error('native client path is not fixed');

  return withCheckpoint(join(machine.checkpointDirectory, 'candidate-checkpoint.json'), async () => {

  await runAndRequire(runCommand, LAUNCHCTL, ['print', `system/${SERVICE_LABEL}`]);

  requireProtectedPath(fileSystem, APP_PATH, 'directory');
  requireProtectedPath(fileSystem, CLIENT_BUNDLE, 'directory');
  requireProtectedPath(fileSystem, CLIENT_BINARY, 'file');
  requireProtectedPath(fileSystem, SERVICE_BUNDLE, 'directory');
  requireProtectedPath(fileSystem, SERVICE_BINARY, 'file');

  for (const path of [APP_PATH, CLIENT_BUNDLE, CLIENT_BINARY, SERVICE_BUNDLE, SERVICE_BINARY]) {
    await verifySignedPath(runCommand, path, release.teamId);
  }

  const ping = await runPinned(machine.executables.native_client, ['--service', SERVICE_LABEL, 'ping'], { production, runCommand });
  requireCommandSuccess(ping, 'native client ping');
  const status = await runPinned(machine.executables.native_client, ['--service', SERVICE_LABEL, 'control-status'], { production, runCommand });
  requireCommandSuccess(status, 'native client control status');

  return TESTS;
  }, { production, expected: { artifactSha256: release.artifactSha256, sourceCommit: release.sourceCommit, teamId: release.teamId, applicationPath: APP_PATH } });
};

export const executeCleanInstallLaunchdXpc = (options) => executePhysicalScenario({
  gate: GATE,
  tests: TESTS,
  ...options,
  execute: (context) => performCleanInstallLaunchdXpc(context),
});

if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
  await runPhysicalScenario({ gate: GATE, tests: TESTS, execute: (context) => performCleanInstallLaunchdXpc(context) });
}
