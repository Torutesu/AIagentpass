{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/schemas/production-evidence-manifest-v1.json",
  "title": "AgentPass A7/A8 production evidence manifest",
  "description": "Candidate-bound signed evidence references. This schema does not assert that external evidence exists; the verifier must still validate every descriptor and protected attestation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "candidate", "gates", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "agentpass.production-evidence-manifest" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "gates": { "$ref": "#/$defs/gates" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "safe_name": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*$" },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bytes", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/safe_name" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
        "sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_name", "artifact_sha256", "candidate_id", "source_commit", "version"],
      "properties": {
        "artifact_name": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._-]*-macos-universal\\.pkg$" },
        "artifact_sha256": { "$ref": "#/$defs/digest" },
        "candidate_id": { "type": "string", "pattern": "^release-pkg-sha256-v1-[0-9a-f]{64}$" },
        "source_commit": { "$ref": "#/$defs/commit" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key_fingerprint", "signature_base64url"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
        "public_key_fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9_-]{43}$" },
        "signature_base64url": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kms", "postgres", "release"],
      "properties": {
        "kms": {
          "type": "object",
          "additionalProperties": false,
          "required": ["report", "trusted_key_id", "trusted_public_key"],
          "properties": {
            "report": { "$ref": "#/$defs/descriptor" },
            "trusted_key_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$" },
            "trusted_public_key": { "$ref": "#/$defs/descriptor" }
          }
        },
        "postgres": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qualification"],
          "properties": { "qualification": { "$ref": "#/$defs/descriptor" } }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attestation", "offline_evidence"],
          "properties": {
            "attestation": { "$ref": "#/$defs/descriptor" },
            "offline_evidence": { "$ref": "#/$defs/descriptor" }
          }
        }
      }
    }
  }
}
