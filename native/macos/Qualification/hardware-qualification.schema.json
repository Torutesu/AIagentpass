{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpass.dev/schemas/macos-hardware-qualification-v1.json",
  "title": "AgentPass macOS hardware qualification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "source_commit", "artifact", "machine", "checks", "qualified"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "agentpass.macos.hardware-qualification" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "signed"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signed": { "const": true },
        "identifier": { "type": "string", "minLength": 1 },
        "team_id": { "type": "string", "pattern": "^[A-Z0-9]{10}$" },
        "cdhashes": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
      }
    },
    "machine": {
      "type": "object", "additionalProperties": false,
      "required": ["architecture", "hardware_class", "model_identifier", "os_version", "os_build"],
      "properties": {
        "architecture": { "enum": ["arm64", "x86_64"] },
        "hardware_class": { "enum": ["apple_silicon", "intel"] },
        "model_identifier": { "type": "string", "minLength": 1 },
        "os_version": { "type": "string", "minLength": 1 },
        "os_build": { "type": "string", "minLength": 1 }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["launchd_host_child_identity", "nsxpc", "crash_restart"],
      "properties": {
        "launchd_host_child_identity": { "allOf": [{ "$ref": "#/$defs/check" }, { "$ref": "#/$defs/launchd_check" }] },
        "nsxpc": { "allOf": [{ "$ref": "#/$defs/check" }, { "$ref": "#/$defs/nsxpc_check" }] },
        "crash_restart": { "allOf": [{ "$ref": "#/$defs/check" }, { "$ref": "#/$defs/restart_check" }] }
      }
    },
    "qualified": { "const": true }
  },
  "$defs": {
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "exit_code", "stdout_sha256", "stderr_sha256", "observed"],
      "properties": {
        "status": { "const": "passed" },
        "exit_code": { "const": 0 },
        "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "observed": { "type": "object", "minProperties": 1 }
      }
    },
    "launchd_check": {
      "type": "object", "properties": { "observed": { "type": "object", "required": ["service_label", "host_pid", "child_pid", "host_identity", "child_identity", "identity_match"], "properties": { "service_label": { "type": "string", "minLength": 1 }, "host_pid": { "type": "integer", "minimum": 1 }, "child_pid": { "type": "integer", "minimum": 1 }, "host_identity": { "type": "object" }, "child_identity": { "type": "object" }, "identity_match": { "const": true } } } }
    },
    "nsxpc_check": {
      "type": "object", "properties": { "observed": { "type": "object", "required": ["mach_service", "connection_accepted", "authorized_client", "wrong_identity_denied"], "properties": { "mach_service": { "type": "string", "minLength": 1 }, "connection_accepted": { "const": true }, "authorized_client": { "const": true }, "wrong_identity_denied": { "const": true } } } }
    },
    "restart_check": {
      "type": "object", "properties": { "observed": { "type": "object", "required": ["initial_pid", "crash_signal", "restarted_pid", "restart_count", "state_recovered"], "properties": { "initial_pid": { "type": "integer", "minimum": 1 }, "crash_signal": { "type": "string", "minLength": 1 }, "restarted_pid": { "type": "integer", "minimum": 1 }, "restart_count": { "type": "integer", "minimum": 1 }, "state_recovered": { "const": true } } } }
    }
  }
}
